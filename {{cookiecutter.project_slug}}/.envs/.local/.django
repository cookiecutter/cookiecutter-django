# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_RUN_MIGRATIONS=True

{%- if cookiecutter.use_tenants == 'y' %}
DJANGO_TENANT_USERS_DOMAIN=localhost
DJANGO_PUBLIC_TENANT_OWNER_EMAIL=admin@example.com
DJANGO_PUBLIC_TENANT_OWNER_PASSWORD=Admin@123
{%- endif %}

{%- if cookiecutter.use_control_room == 'y' %}
CR_REGISTER_PANELS=True
CR_REGISTER_REDIS_PANEL=True
CR_REGISTER_CACHE_PANEL=True
CR_REGISTER_URLS_PANEL=True
CR_REGISTER_CELERY_PANEL=True
{%- endif %}

{%- if cookiecutter.use_celery == 'y' %}
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=!!!SET CELERY_FLOWER_USER!!!
CELERY_FLOWER_PASSWORD=!!!SET CELERY_FLOWER_PASSWORD!!!
{%- endif %}

{%- if cookiecutter.cloud_provider == 'AWS' %}
# AWS
# ------------------------------------------------------------------------------
AWS_ENDPOINT_URL=http://floci:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID={{cookiecutter.project_slug}}
AWS_SECRET_ACCESS_KEY={{cookiecutter.project_slug}}
DJANGO_AWS_ACCESS_KEY_ID={{cookiecutter.project_slug}}
DJANGO_AWS_SECRET_ACCESS_KEY={{cookiecutter.project_slug}}
DJANGO_AWS_S3_REGION_NAME=us-east-1
DJANGO_AWS_STORAGE_BUCKET_NAME={{cookiecutter.project_slug}}-media
{%- endif %}